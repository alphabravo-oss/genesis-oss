{
  "baseBranches": [
    "main"
  ],
  "configWarningReuseIssue": false,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate: Upgrade Alloy Package Dependencies",
  "draftPR": true,
  "enabledManagers": [
    "custom.regex",
    "helmv3"
  ],
  "ignorePaths": [
    "chart/charts/**"
  ],
  "labels": [
    "alloy",
    "renovate",
    "kind::maintenance",
    "team::Republic"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "registry1.dso.mil/ironbank/opensource/grafana/alloy"
      ],
      "groupName": "Ironbank",
      "extractVersion": "^v?(?<version>.*)$",
      "registryUrls": [
        "https://registry1.dso.mil"
      ],
      "postUpgradeTasks": {
        "commands": [
          "regenerate-helm-docs",
          "bump-changelog '- {{{replace 'registry1.dso.mil/' '' depName}}} updated from {{{currentVersion}}} to {{{newVersion}}}'",
          "update-alloy-subcharts"
        ],
        "fileFilters": [
          "chart/Chart.yaml",
          "chart/values.yaml",
          "README.md",
          "CHANGELOG.md"
        ]
      }
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "Ironbank",
      "registryUrls": [
        "https://registry1.dso.mil"
      ],
      "postUpgradeTasks": {
        "commands": [
          "regenerate-helm-docs",
          "bump-changelog '- {{{replace 'registry1.dso.mil/' '' depName}}} updated from {{{currentVersion}}} to {{{newVersion}}}'"
        ],
        "fileFilters": [
          "chart/Chart.yaml",
          "chart/values.yaml",
          "README.md",
          "CHANGELOG.md"
        ]
      },
      "matchPackageNames": [
        "!registry1.dso.mil/ironbank/opensource/grafana/alloy"
      ]
    },
    {
      "matchPackageNames": [
        "registry1.dso.mil/ironbank/opensource/prometheus-operator/prometheus-config-reloader"
      ],
      "groupName": "Ironbank",
      "extractVersion": "^v?(?<version>.*)$",
      "registryUrls": [
        "https://registry1.dso.mil"
      ],
      "postUpgradeTasks": {
        "commands": [
          "regenerate-helm-docs",
          "bump-changelog '- {{{replace 'registry1.dso.mil/' '' depName}}} updated from {{{currentVersion}}} to {{{newVersion}}}'"
        ],
        "fileFilters": [
          "chart/Chart.yaml",
          "chart/values.yaml",
          "README.md",
          "CHANGELOG.md"
        ]
      }
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "groupName": "Ironbank",
      "postUpgradeTasks": {
        "commands": [],
        "fileFilters": [
          "chart/Chart.yaml",
          "README.md",
          "CHANGELOG.md"
        ]
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update chart appVersion to match k8s-monitoring",
      "managerFilePatterns": [
        "/^chart/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s+(?<currentValue>.+)"
      ],
      "depNameTemplate": "k8s-monitoring",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://grafana.github.io/helm-charts"
    },
    {
      "customType": "regex",
      "description": "Update docker image references",
      "managerFilePatterns": [
        "/^chart/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "image:[^\\S\\r\\n]+(?<depName>.+):(?<currentValue>.+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update registry/repository/tag image references in values.yaml",
      "managerFilePatterns": [
        "/^chart/values\\.yaml$/"
      ],
      "matchStrings": [
        "registry:\\s*(?<registry>registry1\\.dso\\.mil)\\s+repository:\\s*(?<depName>[^\\s]+)\\s+tag:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{{registry}}}/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Update full-path repository/tag image references in values.yaml",
      "managerFilePatterns": [
        "/^chart/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*(?<depName>registry1\\.dso\\.mil[^\\s]+)\\s+tag:\\s*(?<currentValue>[^\\s\"]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update k8s-monitoring version",
      "managerFilePatterns": [
        "/^chart/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s+(?<currentValue>.+)-bb\\.\\d+"
      ],
      "depNameTemplate": "k8s-monitoring",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://grafana.github.io/helm-charts"
    }
  ],
  "separateMajorMinor": false,
  "postUpdateOptions": [
    "helmUpdateSubChartArchives"
  ]
}
